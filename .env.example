# ---- Backend (copy to backend/.env for local dev; on Replit use Secrets) ----

# LLM (one provider only). LLM_PROVIDER=mock lets the app run with canned outputs.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# Database. SQLite locally; Replit injects DATABASE_URL for its built-in Postgres.
DATABASE_URL=sqlite:///./data/app.db

# Uploads (relative to backend/)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
MAX_PAGES=200

# Agent. mock = MockMonitoringAgent, openclaw = real gateway call.
AGENT_PROVIDER=mock
# OpenClaw gateway with gateway.http.endpoints.chatCompletions.enabled = true
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_ID=main
OPENCLAW_TIMEOUT_SECONDS=300

# CORS (comma separated). Not needed when the frontend proxies /api.
CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
# Where Next.js proxies /api/* to. Default http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000
