# ---- Backend (copy to backend/.env for local dev; on Replit use Secrets) ----

# LLM (one provider only). LLM_PROVIDER=canned returns placeholder outputs for UI work without a key.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# Database. SQLite locally; Replit injects DATABASE_URL for its built-in Postgres.
DATABASE_URL=sqlite:///./data/app.db

# Uploads (relative to backend/)
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25
MAX_PAGES=200

# Public research: the app calls Brave Search directly, then one OpenAI call. Never via OpenClaw.
# Key from https://api-dashboard.search.brave.com (free tier is enough for a demo).
BRAVE_API_KEY=
BRAVE_RESULT_COUNT=8

# Agent. mock = MockMonitoringAgent, openclaw = real gateway call (used ONLY by Run Agent Check).
AGENT_PROVIDER=mock
# OpenClaw gateway (gateway-box via SSH tunnel locally) with gateway.http.endpoints.chatCompletions.enabled = true
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_ID=default
OPENCLAW_TIMEOUT_SECONDS=300

# CORS (comma separated). Not needed when the frontend proxies /api.
CORS_ORIGINS=http://localhost:3000

# ---- Frontend ----
# Where Next.js proxies /api/* to. Default http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8000
